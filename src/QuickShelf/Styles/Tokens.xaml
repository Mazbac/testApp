<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F7F7" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="BorderBrush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#606060" />
  <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#E5F1FB" />
  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />

  <sys:Double x:Key="RadiusSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">6</sys:Double>
  <Thickness x:Key="ControlPadding">12,8</Thickness>
  <Thickness x:Key="PanelPadding">20</Thickness>
  <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
</ResourceDictionary>
