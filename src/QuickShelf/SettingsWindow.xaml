<Window x:Class="QuickShelf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="QuickShelf settings" Width="520" Height="560" MinHeight="520"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        automation:AutomationProperties.Name="QuickShelf settings">
  <Grid Background="{DynamicResource WindowBackgroundBrush}" Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,22">
      <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
      <TextBlock Text="Appearance, backups and local data" Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,20">
      <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}" />
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="SystemThemeRadio" Content="System" Tag="System" GroupName="Theme"
                     Checked="ThemeRadio_Checked" Margin="0,0,18,0" Foreground="{DynamicResource TextBrush}" automation:AutomationProperties.Name="Use system theme" />
        <RadioButton x:Name="LightThemeRadio" Content="Light" Tag="Light" GroupName="Theme"
                     Checked="ThemeRadio_Checked" Margin="0,0,18,0" Foreground="{DynamicResource TextBrush}" automation:AutomationProperties.Name="Use light theme" />
        <RadioButton x:Name="DarkThemeRadio" Content="Dark" Tag="Dark" GroupName="Theme"
                     Checked="ThemeRadio_Checked" Foreground="{DynamicResource TextBrush}" automation:AutomationProperties.Name="Use dark theme" />
      </StackPanel>
      <TextBlock Text="System follows your Windows app theme." Margin="0,8,0,0" FontSize="12"
                 Foreground="{DynamicResource MutedTextBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,20">
      <TextBlock Text="Backup and restore" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextBrush}" />
      <StackPanel Orientation="Horizontal">
        <Button Content="Export backup..." Click="Export_Click" Margin="0,0,8,0"
                automation:AutomationProperties.Name="Export QuickShelf backup" />
        <Button Content="Import backup..." Click="Import_Click"
                automation:AutomationProperties.Name="Import QuickShelf backup" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="3" Margin="0,0,0,20" Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
      <StackPanel>
        <TextBlock Text="Your data stays local" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <TextBlock Text="QuickShelf stores snippets only on this PC. Uninstall keeps them so a later reinstall can restore your shelf."
                   Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Reset QuickShelf" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="Deletes all snippets and QuickShelf backups from this PC. Export first if you may need them later."
                     Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Reset..." Style="{StaticResource DangerButton}" Click="Reset_Click"
                VerticalAlignment="Center" automation:AutomationProperties.Name="Reset all QuickShelf data" />
      </Grid>
    </Border>

    <Grid Grid.Row="5" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="QuickShelf v0.1.0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
      <Button Grid.Column="1" Content="Done" Style="{StaticResource PrimaryButton}" Click="Done_Click" MinWidth="80"
              automation:AutomationProperties.Name="Close settings" />
    </Grid>
  </Grid>
</Window>
